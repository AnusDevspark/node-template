# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Every variable here is validated by src/config/env.ts
# at startup — the process exits immediately if any required value is missing or
# malformed, so a misconfigured deploy fails loudly instead of half-working.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# 4000, not 3000: the companion Next.js frontend owns 3000 in development, and
# its NEXT_PUBLIC_API_URL points at http://localhost:4000/api/v1.
PORT=4000

# Set to 1 behind exactly one reverse proxy (nginx, ALB, Cloudflare). Controls
# Express `trust proxy`, which is what makes req.ip and rate limiting see the
# real client address instead of the proxy's. Use 0 when there is no proxy —
# setting it too high lets clients spoof X-Forwarded-For and defeat rate limits.
TRUST_PROXY_HOPS=0

# --- Database --------------------------------------------------------------
# Host port the compose database binds to. Change it (and the two URLs below) if
# you already run PostgreSQL on 5432 — the container will refuse to start
# otherwise.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev?schema=public

# Used only by `npm run test:integration`. MUST be a different database from
# DATABASE_URL — the integration suite truncates every table between tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test?schema=public

# --- JWT -------------------------------------------------------------------
# Two independent secrets so a leaked access secret cannot be used to mint
# refresh tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-random-string
JWT_ISSUER=node-backend-template
JWT_AUDIENCE=node-backend-template-api

# Short access token: a stolen one expires fast, and it cannot be revoked
# server-side (that is the tradeoff of stateless JWTs).
JWT_ACCESS_EXPIRES_IN=15m
# Long refresh token: stored hashed and rotated on every use, so it IS revocable.
JWT_REFRESH_EXPIRES_IN=7d

# --- Password hashing (Argon2id) -------------------------------------------
# OWASP-recommended baseline: 19 MiB memory, 2 iterations, 1 lane.
# Raise ARGON2_MEMORY_COST first if you want more resistance; it costs attackers
# the most. Lower it if your container is memory-constrained under login load.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- CORS ------------------------------------------------------------------
# Comma-separated allow-list. Never "*" for an authenticated API.
# The Next.js frontend in development.
CORS_ORIGIN=http://localhost:3000

# --- Logging ---------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Pretty-print logs in dev. Leave false in production so logs stay JSON.
LOG_PRETTY=false

# --- Rate limiting ---------------------------------------------------------
# General API limiter.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter limiter for /auth/login, /auth/register, /auth/refresh.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Request body limits ---------------------------------------------------
BODY_LIMIT=100kb

# --- Docs ------------------------------------------------------------------
# Serve Swagger UI at /api/docs. Turn off in production if the API is private.
SWAGGER_ENABLED=true

# --- Seed bootstrap --------------------------------------------------------
# Used ONLY by `npm run prisma:seed`. Never hardcode these in source.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# --- Shutdown --------------------------------------------------------------
# Hard ceiling on graceful shutdown before the process force-exits.
SHUTDOWN_TIMEOUT_MS=10000
